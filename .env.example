# Copier ce fichier en .env.local et renseigner les valeurs.
# Jamais de valeur reelle ici : ce fichier est versionne.

# URL publique du site (production)
NEXT_PUBLIC_SITE_URL=

# Email de notification du barber (temporaire : email perso pour les tests)
NOTIFY_EMAIL=

# --- Reservation en ligne (etape 7) ---
# Supabase : Project Settings > API (URL du projet + cle secrete / service_role). Serveur uniquement.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend : cle API + expediteur. En test : "Dysicut <onboarding@resend.dev>" (envoie uniquement vers l'email du compte Resend).
# En production : un expediteur sur un domaine verifie, ex. "Dysicut <rdv@ton-domaine.fr>".
RESEND_API_KEY=
RESEND_FROM=

# Secret du cron de rappels (chaine aleatoire longue, ex. : openssl rand -base64 32). Vercel l'envoie en Bearer.
CRON_SECRET=

# --- Admin (etape 8) ---
# Email du SEUL compte autorise a se connecter a /admin. Creer ce compte dans Supabase > Authentication > Users
# (Add user, mot de passe, "Auto Confirm"), et DESACTIVER les inscriptions : Authentication > Sign In / Providers > "Allow new users to sign up" = off.
ADMIN_EMAIL=

# --- Acompte et anti-lapin (Stripe) ---
# Stripe : Developers > API keys (cle secrete sk_...). Commencer en mode test (sk_test_...).
STRIPE_SECRET_KEY=
# Stripe : Developers > Webhooks > ajouter l'endpoint https://TON-DOMAINE/api/stripe/webhook avec les evenements
# checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired, puis copier le "Signing secret" (whsec_...).
# En local : `stripe listen --forward-to localhost:3000/api/stripe/webhook` affiche ce secret.
STRIPE_WEBHOOK_SECRET=
