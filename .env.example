# Copier ce fichier en .env.local et renseigner les valeurs.
# Jamais de valeur reelle ici : ce fichier est versionne.

# URL publique du site (production)
NEXT_PUBLIC_SITE_URL=

# Email de notification du barber (temporaire : email perso pour les tests)
NOTIFY_EMAIL=

# --- Reservation en ligne (etape 7) ---
# Supabase : Project Settings > API (URL du projet + cle secrete / service_role). Serveur uniquement.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend : cle API + expediteur. En test : "Dysicut <onboarding@resend.dev>" (envoie uniquement vers l'email du compte Resend).
# En production : un expediteur sur un domaine verifie, ex. "Dysicut <rdv@ton-domaine.fr>".
RESEND_API_KEY=
RESEND_FROM=

# Secret du cron de rappels (chaine aleatoire longue, ex. : openssl rand -base64 32). Vercel l'envoie en Bearer.
CRON_SECRET=
